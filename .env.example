# Copy this file to .env.dev, .env.stage, or .env.prod.
# Start with APP_ENV=dev npm run start, APP_ENV=stage npm run start, or APP_ENV=prod npm run start.

EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_BASE_URL=https://identitytoolkit.googleapis.com/v1
EXPO_PUBLIC_FIREBASE_CLIENT_TYPE=CLIENT_TYPE_WEB
EXPO_PUBLIC_ENABLE_IN_APP_DEBUG_CONSOLE=true
